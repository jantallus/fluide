# Configuration du serveur local
PORT=3001

# Base de données (Remplacer par l'URL fournie par Railway)
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote:port/nom_de_la_base

# Sécurité (Générer une clé aléatoire avec Node.js ou OpenSSL)
JWT_SECRET=inserer_votre_secret_jwt_ici

# Stripe
STRIPE_SECRET_KEY=sk_live_...
# Secret de signature du webhook — récupéré dans le dashboard Stripe > Webhooks
# En local avec Stripe CLI : stripe listen --forward-to localhost:3001/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Apps Script (synchro calendrier moniteurs)
# URL du script déployé — optionnel, fallback sur l'URL hardcodée si absent
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/...

# CORS — origines autorisées
# FRONTEND_URL accepte une ou plusieurs URLs séparées par des virgules.
# En prod : mettre ici le(s) domaine(s) admin (ex: https://admin.parabooking.app)
# Pendant une migration : "https://admin.parabooking.app,https://ancien-domaine.up.railway.app"
FRONTEND_URL=http://localhost:3000

# URL Tailscale pour accès local réseau (optionnel)
TAILSCALE_URL=

# WordPress / site vitrine (optionnel, ajouté au CORS)
WORDPRESS_URL=

# Sentry (monitoring erreurs — optionnel, no-op si absent)
# Créer un projet Node.js sur https://sentry.io → Settings > Projects > DSN
# Format : https://<key>@<host>/api/<project_id>/store/
SENTRY_DSN=